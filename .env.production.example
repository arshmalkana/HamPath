# HamPath production settings. Copy to .env.production on the server (never commit it):
#   cp .env.production.example .env.production && chmod 600 .env.production
# Generate secrets with:  openssl rand -base64 36

# Public address, exactly as learners type it (used for sign-in links, the Google redirect and the
# cross-site write check).
APP_ORIGIN=https://hampath.example.com

# Database (internal to the stack; never published).
POSTGRES_PASSWORD=

# Admin API token for scripts (32+ random characters). Admin users sign in normally.
ADMIN_TOKEN=

# Sign-in e-mails. Any SMTP relay: smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM=HamPath <no-reply@hampath.example.com>

# Google sign-in (optional). Authorised redirect URI: ${APP_ORIGIN}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where Nginx Proxy Manager reaches the web server on this VM.
WEB_PORT=8090
# 0.0.0.0 when NPM runs on another machine/LXC; 127.0.0.1 when it runs on this VM.
WEB_BIND=0.0.0.0

# Error monitoring (GlitchTip or Sentry). Leave empty to turn off.
# SENTRY_DSN: server-side errors (API and web server).
SENTRY_DSN=
# SENTRY_DSN_BROWSER: browser errors; baked in at build time (often the same DSN).
SENTRY_DSN_BROWSER=
SENTRY_ENVIRONMENT=production
# The monitoring host, so the browser may post reports to it (CSP connect-src), e.g. https://glitchtip.example.com
CSP_CONNECT_EXTRA=

# Backups: nightly pg_dump into BACKUP_DIR, kept BACKUP_KEEP_DAYS days. BACKUP_PUSH_URL is an
# Uptime Kuma push monitor URL, pinged after each good backup.
BACKUP_DIR=/opt/hampath/backups
BACKUP_KEEP_DAYS=14
BACKUP_PUSH_URL=

# Set by the deploy workflow (git SHA); shown in error reports.
APP_VERSION=

# --- Database (docker compose: pnpm db:up) ---
DATABASE_URL=postgres://hampath:hampath@127.0.0.1:5433/hampath
# Tests create and drop this database; never point it at real data.
DATABASE_URL_TEST=postgres://hampath:hampath@127.0.0.1:5433/hampath_test

# --- API ---
API_PORT=4000
# Public origin of the web app (magic links and OAuth redirects point here)
APP_ORIGIN=http://localhost:3000
# x-admin-token for POST /api/v1/admin/import-bank from scripts (signed-in admins don't need it)
ADMIN_TOKEN=change-me-dev-only

# --- E-mail (magic links). Dev: Mailpit from docker compose, inbox at http://localhost:8025 ---
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM="HamPath <no-reply@hampath.local>"

# --- Google sign-in (optional; the button is hidden until both are set) ---
# Authorized redirect URI: ${APP_ORIGIN}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Web (Next.js server-side fetches and the /api rewrite) ---
API_ORIGIN=http://127.0.0.1:4000

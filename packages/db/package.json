{
  "name": "@hampath/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PostgreSQL 16 schema (Drizzle), migrations, seed and the ISED bank importer.",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/cli/migrate.ts",
    "seed": "tsx src/cli/seed.ts",
    "import-bank": "tsx src/cli/import-bank.ts",
    "load-content": "tsx src/cli/load-content.ts",
    "ensure": "tsx src/cli/ensure.ts",
    "make-admin": "tsx src/cli/make-admin.ts"
  },
  "dependencies": {
    "@hampath/content": "workspace:*",
    "@hampath/ham-sim": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}

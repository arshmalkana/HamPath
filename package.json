{
  "name": "hampath",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @hampath/web build",
    "test": "node scripts/vitest.mjs run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel typecheck",
    "check:content": "tsx packages/content/src/cli/check.ts",
    "coverage": "tsx packages/content/src/cli/coverage.ts",
    "db:up": "docker compose up -d --wait db mailpit",
    "db:migrate": "pnpm --filter @hampath/db migrate",
    "db:generate": "pnpm --filter @hampath/db generate",
    "db:seed": "pnpm --filter @hampath/db seed",
    "import:bank": "pnpm --filter @hampath/db import-bank",
    "db:load-content": "pnpm --filter @hampath/db load-content",
    "db:setup": "pnpm db:up && pnpm db:migrate && pnpm db:seed && pnpm import:bank && pnpm db:load-content",
    "db:reset": "docker compose down -v db && pnpm db:setup",
    "db:make-admin": "pnpm --filter @hampath/db make-admin",
    "smoke": "pnpm --filter @hampath/api smoke"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0",
    "@hampath/content": "workspace:*",
    "@hampath/db": "workspace:*",
    "pg": "^8.23.1",
    "@types/pg": "^8.23.1",
    "eslint-config-next": "^16.4.6",
    "globals": "^17.14.0"
  }
}
